{
  "name": "Signit",
  "short_name": "Signit",
  "description": "הסכמי רכב ומסמכים לחתימה: מילוי, חתימה, שליחה ושמירה",
  "lang": "he",
  "dir": "rtl",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F7F3EA",
  "theme_color": "#F7F3EA",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "הסכמי רכב", "url": "./#car", "icons": [ { "src": "icon-192.png", "sizes": "192x192" } ] },
    { "name": "מסמכים", "url": "./#docs", "icons": [ { "src": "docs/icon-192.png", "sizes": "192x192" } ] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "files": [ { "name": "file", "accept": ["application/pdf", ".pdf"] } ] }
  },
  "file_handlers": [ { "action": "./", "accept": { "application/pdf": [".pdf"] } } ]
}
